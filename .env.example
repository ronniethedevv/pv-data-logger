# Data source — the Google Sheet the logger appends to.

# RECOMMENDED for deployed hosts (Vercel, etc.): the sheet's "Publish to web"
# CSV link. In the Sheet: File → Share → Publish to web → pick the tab → CSV.
# Google serves this anonymously from any IP, unlike the gviz link below which
# it blocks from datacenter IPs (you'll see "Sheet responded 404" without this).
# If set, this takes precedence over SHEET_ID / SHEET_GID.
SHEET_CSV_URL=

# Fallback used when SHEET_CSV_URL is empty (fine for local dev). The tab must be
# shared as "Anyone with the link can view".
SHEET_ID=1k00TxA9Z1YWQsqbopmQAeSCsULbM4bc05_caFlNNxkM
SHEET_GID=0

# Timezone the logger records DATE/TIME in, so timestamps parse correctly on a
# UTC host like Vercel (e.g. Africa/Lagos). Optional; defaults to the host TZ.
TZ=
