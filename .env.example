# Data source — the Google Sheet the logger appends to.
# The app tries these in order; the first one set wins.

# 1. RECOMMENDED for deployed hosts (Vercel, etc.). Google Sheets API key.
# Works from any IP and needs NO access to the sheet — you don't have to own or
# share it, as long as it's viewable by "anyone with the link". Create a free
# key: console.cloud.google.com → new project → enable "Google Sheets API" →
# Credentials → API key. See the README for the full walkthrough.
SHEETS_API_KEY=
# A1 range for the API. Leave as-is for the first tab; set e.g. "Log!A:L" only if
# the data is on a differently-named tab.
SHEET_RANGE=A:L

# 2. Sheet owners only: a "Publish to web" CSV link
# (File → Share → Publish to web → pick the tab → CSV).
SHEET_CSV_URL=

# 3. Fallback for LOCAL DEV only (Google 404s this from datacenter IPs, so it
# won't work on Vercel). The tab must be "Anyone with the link can view".
SHEET_ID=1k00TxA9Z1YWQsqbopmQAeSCsULbM4bc05_caFlNNxkM
SHEET_GID=0

# Timezone the logger records DATE/TIME in, so timestamps parse correctly on a
# UTC host like Vercel (e.g. Africa/Lagos). Optional; defaults to the host TZ.
TZ=
